# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI
# Replace <username>, <password>, and <cluster> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hlstack?retryWrites=true&w=majority

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Notifications (Optional - gracefully falls back to console logging if omitted)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=admissions@hlstack.edu
